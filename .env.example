# bucket-arca - configuração. Copie para .env e preencha. Tudo aqui é lido do ambiente do container.
# Chaves também podem vir de arquivo (Docker secrets): use VARIAVEL_FILE=/run/secrets/...
# Detalhes de cada opção: README.md.

# =========================================================== Origem (o bucket a copiar)
# r2 | aws | s3 (qualquer compatível) | local (pasta) | rclone (qualquer serviço do rclone)
SOURCE_PROVIDER=r2
SOURCE_BUCKET=meu-bucket
SOURCE_R2_ACCOUNT_ID=
# Credencial SÓ DE LEITURA (R2: token "Object Read only" restrito a este bucket).
SOURCE_ACCESS_KEY_ID=
SOURCE_SECRET_ACCESS_KEY=
# SOURCE_SECRET_ACCESS_KEY_FILE=/run/secrets/r2_secret
# Copiar só uma pasta do bucket (vazio = o bucket inteiro).
# SOURCE_PREFIX=
# --- aws: SOURCE_REGION=sa-east-1
# --- s3 compatível: SOURCE_ENDPOINT=https://...  SOURCE_S3_PROVIDER=Other  SOURCE_FORCE_PATH_STYLE=true
# --- local: SOURCE_PATH=/dados
# --- rclone: RCLONE_CONFIG_ORIGEM_TYPE=... (+ opções do serviço) e SOURCE_PATH=caminho

# =========================================================== Destino (para onde vão as cópias)
# aws | r2 | s3 | local | rclone (mesmas opções da origem, com STORAGE_ no lugar de SOURCE_)
STORAGE_PROVIDER=aws
STORAGE_BUCKET=meu-bucket-de-backups
STORAGE_REGION=sa-east-1
# Pasta dentro do bucket. As cópias ficam em <STORAGE_PREFIX>/<BACKUP_NAME>/{atual,historico,snapshots}
STORAGE_PREFIX=bucket-backups
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=
# STORAGE_SECRET_ACCESS_KEY_FILE=/run/secrets/aws_secret
# Criptografia no próprio S3 (aws): AES256 (padrão) ou aws:kms
# STORAGE_SERVER_SIDE_ENCRYPTION=AES256
# --- rclone: RCLONE_CONFIG_ARCA_TYPE=... (+ opções do serviço) e STORAGE_PATH=caminho

# Nome desta cópia (pasta no destino). Padrão: o nome do bucket de origem.
# BACKUP_NAME=meu-bucket

# =========================================================== Espelho (incremental, diário)
# Formato cron (minuto hora dia mês dia-da-semana). "off" desliga.
MIRROR_SCHEDULE=0 3 * * *
# true  = o que for alterado/apagado na origem vai antes para historico/<data>/ (opção 1)
# false = só espelho; use com um bucket com Versioning ligado (opção 2)
MIRROR_HISTORY=true
# Como saber se um arquivo mudou: checksum (MD5, padrão, sem requisição extra) | modtime | size
MIRROR_COMPARE=checksum
# Classe (tier) dos arquivos do espelho e do histórico. Vazio = padrão do bucket.
MIRROR_STORAGE_CLASS=STANDARD
# Trava: recusa o espelho se ele for remover mais que N% dos arquivos da cópia (mínimo 10
# arquivos). 0 desliga. "arca mirror --force" passa por cima uma vez.
MIRROR_MAX_DELETE_PERCENT=25
# Apagar datas do histórico com mais de N dias (0 = não apaga; prefira a regra de ciclo de vida).
HISTORY_RETENTION_DAYS=0

# =========================================================== Snapshot (completo, semanal)
# Padrão: domingo às 4h. "off" desliga.
SNAPSHOT_SCHEDULE=0 4 * * 0
# zstd | zstd:N (1-19) | gzip | gzip:N (1-9) | none
SNAPSHOT_COMPRESSION=zstd
# GLACIER_IR: barato e restaura na hora (mínimo 90 dias). Ver README antes de usar DEEP_ARCHIVE.
SNAPSHOT_STORAGE_CLASS=GLACIER_IR
# Apagar snapshots com mais de N dias (0 = não apaga; prefira a regra de ciclo de vida).
# Os SNAPSHOT_KEEP_MIN mais novos nunca são apagados.
SNAPSHOT_RETENTION_DAYS=0
SNAPSHOT_KEEP_MIN=3
# Pasta de trabalho do snapshot: precisa de ~2x o tamanho da origem livre.
# TMPDIR=/tmp

# =========================================================== Criptografia do snapshot
# Chave(s) PÚBLICA(s) do age (age1...), separadas por vírgula. Gere com: age-keygen -o chave.txt
# A chave PRIVADA (AGE-SECRET-KEY-...) NÃO fica aqui: guarde num cofre de senhas. Só é usada
# para abrir um snapshot (AGE_IDENTITY ou AGE_IDENTITY_FILE, só na hora de restaurar).
BACKUP_ENCRYPTION_RECIPIENTS=

# =========================================================== Agenda e aviso
TZ=America/Sao_Paulo
# Roda os trabalhos ligados assim que o container sobe (além do agendado).
BACKUP_ON_STARTUP=false
# Monitor "Push" do Uptime Kuma: recebe status=up (sucesso) ou status=down (falha).
HEALTHCHECK_URL=
# Um monitor para cada trabalho (opcional; sem elas, os dois usam HEALTHCHECK_URL):
# MIRROR_HEALTHCHECK_URL=
# SNAPSHOT_HEALTHCHECK_URL=

# =========================================================== rclone (opcional)
# Qualquer opção do rclone por variável RCLONE_<OPÇÃO>, ex.:
# RCLONE_TRANSFERS=8
# RCLONE_BWLIMIT=10M
